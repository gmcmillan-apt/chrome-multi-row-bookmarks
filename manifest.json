{
  "manifest_version": 3,
  "name": "Multi-Row Bookmarks Bar",
  "version": "1.0.0",
  "description": "Replaces Chrome's single-row bookmarks bar with a configurable multi-row toolbar (2-4 rows) with drag-and-drop.",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/constants.js",
        "shared/favicon.js",
        "content/toolbar.js",
        "content/folder-dropdown.js",
        "content/drag-drop.js",
        "content/content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon32.png",
    "default_title": "Multi-Row Bookmarks Settings"
  }
}
